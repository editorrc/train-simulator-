; Engine configuration file.
; Godot version is pinned: 4.7.2-stable (see docs/DECISIONS.md, D-001).

config_version=5

[application]

config/name="Ukraine Visual Train Sim"
config/version="0.3.2"
config/description="Realistic Ukrainian railway simulator"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.7")

[audio]

driver/output_latency=80

[autoload]

EventBus="*res://autoload/event_bus.gd"
SimClock="*res://autoload/sim_clock.gd"
ContentDB="*res://autoload/content_db.gd"
ModLoader="*res://autoload/mod_loader.gd"
Settings="*res://autoload/settings.gd"
Locale="*res://autoload/locale.gd"
Session="*res://autoload/session.gd"

[debug]

gdscript/warnings/untyped_declaration=2
gdscript/warnings/unsafe_property_access=1
gdscript/warnings/unsafe_method_access=1
gdscript/warnings/unsafe_call_argument=1

[display]

window/dpi/allow_hidpi=true
window/size/window_width_override=1600
window/size/window_height_override=1000
window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[internationalization]

locale/fallback="uk"

[physics]

common/physics_ticks_per_second=60

[rendering]

textures/vram_compression/import_etc2_astc=true

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

environment/defaults/default_clear_color=Color(0.08, 0.09, 0.11, 1)
