{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/editorrc/train-simulator-/schemas/stations.schema.json",
  "title": "Stations and stopping points (stations.json)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "stations"
  ],
  "properties": {
    "meta": {
      "$ref": "#/$defs/meta"
    },
    "stations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name_uk",
          "kind",
          "platforms"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "name_uk": {
            "type": "string"
          },
          "name_ru": {
            "type": "string"
          },
          "name_en": {
            "type": "string"
          },
          "former_names_uk": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "kind": {
            "enum": [
              "station",
              "stop",
              "depot"
            ],
            "description": "station = станція (with switches/ДСП), stop = зупинний пункт"
          },
          "platforms": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "segment",
                "from_m",
                "to_m",
                "side"
              ],
              "properties": {
                "id": {
                  "$ref": "#/$defs/id"
                },
                "segment": {
                  "$ref": "#/$defs/id"
                },
                "from_m": {
                  "type": "number",
                  "minimum": 0
                },
                "to_m": {
                  "type": "number",
                  "minimum": 0
                },
                "side": {
                  "enum": [
                    "left",
                    "right",
                    "both"
                  ],
                  "description": "relative to travel A→B on the segment"
                },
                "height": {
                  "enum": [
                    "low",
                    "high"
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "meta": {
      "type": "object",
      "required": [
        "verified",
        "sources"
      ],
      "properties": {
        "verified": {
          "type": "boolean",
          "description": "false = placeholder value, must be confirmed (docs/RESEARCH.md)"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "note": {
          "type": "string"
        }
      }
    }
  }
}
