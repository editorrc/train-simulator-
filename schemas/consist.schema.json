{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/editorrc/train-simulator-/schemas/consist.schema.json",
  "title": "Train formation (rolling_stock/<series>/consist.json)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "series",
    "meta",
    "vehicles"
  ],
  "properties": {
    "id": {
      "$ref": "#/$defs/id"
    },
    "series": {
      "type": "string"
    },
    "name_uk": {
      "type": "string"
    },
    "meta": {
      "$ref": "#/$defs/meta"
    },
    "electrification": {
      "type": "array",
      "items": {
        "enum": [
          "ac_25kv",
          "dc_3kv"
        ]
      }
    },
    "vehicles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/id"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "meta": {
      "type": "object",
      "required": [
        "verified",
        "sources"
      ],
      "properties": {
        "verified": {
          "type": "boolean",
          "description": "false = placeholder value, must be confirmed (docs/RESEARCH.md)"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "note": {
          "type": "string"
        }
      }
    }
  }
}
