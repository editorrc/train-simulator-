{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/editorrc/train-simulator-/schemas/geometry.schema.json",
  "title": "Drawing geometry (geometry.json). Never read by the simulation core.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "crs",
    "polylines"
  ],
  "properties": {
    "meta": {
      "$ref": "#/$defs/meta"
    },
    "crs": {
      "enum": [
        "local_m",
        "EPSG:32636"
      ],
      "description": "local_m = arbitrary metric plane; EPSG:32636 = UTM zone 36N"
    },
    "origin": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "polylines": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "segment",
          "points"
        ],
        "properties": {
          "segment": {
            "$ref": "#/$defs/id"
          },
          "points": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 3,
              "items": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "map_features": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "points"
        ],
        "properties": {
          "kind": {
            "enum": [
              "river"
            ]
          },
          "label_uk": {
            "type": "string"
          },
          "points": {
            "type": "array",
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "number"
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "meta": {
      "type": "object",
      "required": [
        "verified",
        "sources"
      ],
      "properties": {
        "verified": {
          "type": "boolean",
          "description": "false = placeholder value, must be confirmed (docs/RESEARCH.md)"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "note": {
          "type": "string"
        }
      }
    }
  }
}
