{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/editorrc/train-simulator-/schemas/liveries.schema.json",
  "title": "Paint schemes for a series (rolling_stock/<series>/liveries.json)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "series",
    "meta",
    "liveries"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "series": {
      "type": "string"
    },
    "meta": {
      "type": "object",
      "required": [
        "verified",
        "sources"
      ],
      "properties": {
        "verified": {
          "type": "boolean"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "note": {
          "type": "string"
        }
      }
    },
    "liveries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name_uk",
          "body",
          "stripe",
          "skirt",
          "roof",
          "front",
          "front_stripe",
          "window_frame",
          "number"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "name_uk": {
            "type": "string"
          },
          "body": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "stripe": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "skirt": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "roof": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "front": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "front_stripe": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "window_frame": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "number": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          }
        }
      }
    }
  }
}
