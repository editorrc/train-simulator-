{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/editorrc/train-simulator-/schemas/vehicle.schema.json",
  "title": "Single vehicle (rolling_stock/<series>/vehicles/<id>.json)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "series",
    "type",
    "meta",
    "mass_empty_t",
    "length_m",
    "axles",
    "powered_axles",
    "resistance",
    "brakes"
  ],
  "properties": {
    "id": {
      "$ref": "#/$defs/id"
    },
    "series": {
      "type": "string"
    },
    "type": {
      "enum": [
        "head_trailer",
        "head_motor",
        "motor",
        "trailer",
        "locomotive",
        "coach",
        "wagon"
      ]
    },
    "name_uk": {
      "type": "string"
    },
    "meta": {
      "$ref": "#/$defs/meta"
    },
    "gauge_mm": {
      "const": 1520
    },
    "mass_empty_t": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "length_m": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "axles": {
      "type": "integer",
      "minimum": 2
    },
    "powered_axles": {
      "type": "integer",
      "minimum": 0
    },
    "seats": {
      "type": "integer",
      "minimum": 0
    },
    "has_cab": {
      "type": "boolean"
    },
    "max_speed_kmh": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "rotational_inertia_coef": {
      "type": "number",
      "minimum": 0,
      "maximum": 0.5
    },
    "resistance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "a",
        "b",
        "c",
        "units"
      ],
      "properties": {
        "model": {
          "const": "davis"
        },
        "a": {
          "type": "number"
        },
        "b": {
          "type": "number"
        },
        "c": {
          "type": "number"
        },
        "units": {
          "const": "N_per_kN_v_kmh",
          "description": "w0 = a + b·v + c·v², N/kN, v in km/h (ПТР convention)"
        },
        "starting_n_per_kn": {
          "type": "number",
          "minimum": 0,
          "description": "extra resistance when starting from rest (ПТР), N/kN; fades out by ~5 km/h"
        }
      }
    },
    "visual": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "body": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "stripe": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "roof": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "front": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "doors_per_side": {
          "type": "integer",
          "minimum": 0
        },
        "windows_per_side": {
          "type": "integer",
          "minimum": 0
        },
        "height_m": {
          "type": "number"
        },
        "floor_m": {
          "type": "number"
        },
        "bogie_centers_m": {
          "type": "number",
          "description": "distance between bogie pivots"
        },
        "axle_spacing_m": {
          "type": "number"
        },
        "wheel_diameter_m": {
          "type": "number"
        },
        "body_end_inset_m": {
          "type": "number",
          "minimum": 0,
          "description": "Unverified visual suspension/coupling parameter; see vehicle meta TODO_SOURCE"
        },
        "secondary_frequency_hz": {
          "type": "number",
          "minimum": 0,
          "description": "Unverified visual suspension/coupling parameter; see vehicle meta TODO_SOURCE"
        },
        "secondary_roll_rad_per_ms2": {
          "type": "number",
          "minimum": 0,
          "description": "Unverified visual suspension/coupling parameter; see vehicle meta TODO_SOURCE"
        },
        "secondary_pitch_rad_per_ms2": {
          "type": "number",
          "minimum": 0,
          "description": "Unverified visual suspension/coupling parameter; see vehicle meta TODO_SOURCE"
        },
        "coupler_stiffness_n_m": {
          "type": "number",
          "minimum": 0,
          "description": "Unverified visual suspension/coupling parameter; see vehicle meta TODO_SOURCE"
        }
      }
    },
    "traction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_force_kn",
        "max_power_kw"
      ],
      "description": "Motor cars only. Simple model until T3.2: F = min(force_frac·Fmax, power_frac·Pmax / v).",
      "properties": {
        "max_force_kn": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_power_kw": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "brakes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_brake_force_kn"
      ],
      "properties": {
        "max_brake_force_kn": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "at full brake demand (1.0), simple model until T3.1"
        }
      }
    },
    "has_pantograph": {
      "type": "boolean"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "meta": {
      "type": "object",
      "required": [
        "verified",
        "sources"
      ],
      "properties": {
        "verified": {
          "type": "boolean",
          "description": "false = placeholder value, must be confirmed (docs/RESEARCH.md)"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "note": {
          "type": "string"
        }
      }
    }
  }
}
